# Configurazione Supabase — copia questo file in ".env" e inserisci i valori reali.
# Il file .env NON va mai pubblicato (è escluso in .gitignore).

# URL del progetto Supabase (es. https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chiave pubblica "anon" del progetto Supabase
VITE_SUPABASE_ANON_KEY=
